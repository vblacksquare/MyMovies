{
  "name": "my-movies",
  "private": true,
  "version": "0.0.0",
  "main": "main.ts",
  "scripts": {
    "dev": "vite",
    "electron": "electron main.ts",
    "electron:dev": "concurrently \"vite\" \"electron main.ts\"",
    "electron:build": "electron-builder",
    "build": "vite build",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.mymovies.app",
    "productName": "MyMovies",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.ts",
      "package.json",
      "backend/**/*",
      "build/*"
    ],
    "asarUnpack": [
      "backend/**"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.entertainment"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/vue-table": "^8.21.3",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-vue": "^8.6.0",
    "hls.js": "^1.6.15",
    "lucide-vue-next": "^0.577.0",
    "node": "^25.8.1",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "plyr": "^3.8.4",
    "reka-ui": "^2.9.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.1",
    "videojs-contrib-hls": "^5.15.0",
    "vue": "^3.5.30",
    "vue-input-otp": "^0.3.2",
    "vue-router": "^5.0.4",
    "vue-sonner": "^2.0.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.0",
    "concurrently": "^9.2.1",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vue-tsc": "^3.2.5"
  }
}
